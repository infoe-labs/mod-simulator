# Build output (regenerated by tools/export.sh and CI)
dist/

# Browser test artefacts
shots/
tools/*/node_modules/
tools/e2e/package-lock.json
# Persistent browser profile the perf benches use to keep downloaded weights
tools/e2e/.profile-ai/

# Model weights fetched by tools/ai/fetch_models.sh for local self-hosting.
# They are ~100 MB, are downloaded by consent at runtime otherwise, and must
# never be committed.
game/web/ai/models/

# Godot
game/.godot/
game/*.imported/
*.tmp

# Python
__pycache__/
*.pyc

# Editors / OS
.vscode/
.DS_Store
