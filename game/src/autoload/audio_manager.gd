extends Node

## Autoload: original sound effects + the cozy loop, all generated by
## tools/make_audio.py and bundled in the pck. Every call degrades to a no-op
## if a file is missing, so the game is never gated on audio existing.

const SFX_DIR := "res://assets/audio/"
const SFX_NAMES := [
	"click", "back", "allow", "delete", "ban", "error", "combo",
	"msg_new", "phase", "win", "lose", "heart", "tick", "open",
]
const MUSIC_TRACKS := ["loop_cozy", "loop_tense", "loop_sad"]
const VOICES := 6

var master := 1.0
var music_volume := 0.6
var sfx_volume := 0.9
var muted := false

var _pool: Array[AudioStreamPlayer] = []
var _streams := {}
var _music: AudioStreamPlayer
var _music_name := ""
var _rr := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = &"Master"
		p.finished.connect(_on_finished.bind(p))
		add_child(p)
		_pool.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = &"Master"
	_music.finished.connect(_on_music_finished)
	add_child(_music)
	_load_streams()
	refresh_from_settings()


func _load_streams() -> void:
	for n in SFX_NAMES:
		var path: String = SFX_DIR + n + ".wav"
		if ResourceLoader.exists(path):
			_streams[n] = load(path)
	for n in MUSIC_TRACKS:
		var mpath: String = SFX_DIR + n + ".wav"
		if ResourceLoader.exists(mpath):
			_streams[n] = load(mpath)


func has_sound(name: String) -> bool:
	return _streams.has(name)


func refresh_from_settings() -> void:
	master = float(SaveManager.setting("master"))
	music_volume = float(SaveManager.setting("music"))
	sfx_volume = float(SaveManager.setting("sfx"))
	muted = bool(SaveManager.setting("mute"))
	_apply_volume()


func _apply_volume() -> void:
	_music.volume_db = _db(master * music_volume)
	for p in _pool:
		p.volume_db = _db(master * sfx_volume)


func _db(v: float) -> float:
	if muted or v <= 0.001:
		return -80.0
	return linear_to_db(clampf(v, 0.0, 1.0))


func play(name: String, volume_db: float = 0.0, pitch_scale: float = 1.0) -> void:
	if muted or not _streams.has(name):
		return
	var best: AudioStreamPlayer = null
	for p in _pool:
		if not p.playing:
			best = p
			break
	if best == null:
		_rr = (_rr + 1) % VOICES
		best = _pool[_rr]
	best.stream = _streams[name]
	best.volume_db = _db(master * sfx_volume) + volume_db
	best.pitch_scale = clampf(pitch_scale, 0.5, 2.0)
	best.play()


func play_at(name: String, position: Vector2, volume_db: float = 0.0) -> void:
	## Kept for parity with positional callers; the UI is 2D so it just pans.
	play(name, volume_db)


func play_music(name: String) -> void:
	if name == _music_name and _music.playing:
		return
	_music_name = name
	if not _streams.has(name):
		return
	_music.stream = _streams[name]
	_music.volume_db = _db(master * music_volume)
	_music.play()


func stop_music() -> void:
	_music_name = ""
	_music.stop()


func set_muted(v: bool) -> void:
	muted = v
	SaveManager.set_setting("mute", v)
	_apply_volume()
	if v:
		_music.stop()
	elif _music_name != "":
		play_music(_music_name)


func _on_finished(_p: AudioStreamPlayer) -> void:
	pass


func _on_music_finished() -> void:
	if _music_name != "" and _streams.has(_music_name):
		_music.play()
